# Base URL of the API (riwi-api) for production builds. Leave empty in dev — the
# Vite proxy forwards /api and /lti to the API (see vite.config.ts / API_TARGET).
# VITE_API_BASE_URL="https://your-api.example.com"

# Dev-only: override the API the Vite proxy points at (default http://localhost:3000)
# API_TARGET="http://localhost:3000"
